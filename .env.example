APP_ENV=development
APP_BASE_URL=http://localhost:5173
HTTP_ADDRESS=:8080
HTTP_MAX_HEADER_BYTES=32768
HTTP_MAX_REQUEST_URI_BYTES=8192
TRUST_PROXY_HEADERS=false
RATE_LIMIT_WINDOW=1m
RATE_LIMIT_AUTH_REQUESTS=10
RATE_LIMIT_ORDER_REQUESTS=5
RATE_LIMIT_DOWNLOAD_REQUESTS=30
RATE_LIMIT_ADMIN_WRITE_REQUESTS=60
DATABASE_URL=postgres://nmp:nmp_dev_only@postgres:5432/nmp?sslmode=disable
DATABASE_MAX_CONNECTIONS=5
DATABASE_TIMEOUT=5s
SESSION_COOKIE_NAME=nmp_session
SESSION_TTL=720h
ADMIN_GOOGLE_SUB=

# Required by later backend phases; keep real secrets only in .env.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8080/api/v1/auth/google/callback
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
# Public HTTPS origin used in Checkout Pro back_urls and notification_url.
MERCADOPAGO_PUBLIC_BASE_URL=
# Only for E2E tests (see e2e/README.md) — overrides which host the client
# talks to for preference creation/payment verification. Leave empty in
# every real environment; empty means "use the real Mercado Pago API".
MERCADOPAGO_API_BASE_URL=
# Google Workspace service account with domain-wide delegation and gmail.send.
# Keep the JSON outside the repository and mount it read-only in production.
GOOGLE_MAIL_SENDER=ventas@example.com
GOOGLE_MAIL_CREDENTIALS_PATH=
SUPPORT_EMAIL=soporte@example.com
EMAIL_WORKER_INTERVAL=10s
EMAIL_LEASE_TIMEOUT=5m
EMAIL_BATCH_SIZE=5
EMAIL_MAX_ATTEMPTS=5
EBOOK_STORAGE_PATH=/data/ebooks
EBOOK_INTERNAL_PREFIX=/_protected/ebooks
EBOOK_MAX_UPLOAD_BYTES=52428800
MEDIA_STORAGE_PATH=/data/media
MEDIA_MAX_UPLOAD_BYTES=10485760
MANUSCRIPT_MAX_UPLOAD_BYTES=20971520
