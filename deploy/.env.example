APP_DOMAIN=example.com
BACKEND_IMAGE=ghcr.io/example/nuestra-medicina-personal-backend:latest
WEB_IMAGE=ghcr.io/example/nuestra-medicina-personal-web:latest

POSTGRES_DB=nmp
POSTGRES_USER=nmp
POSTGRES_PASSWORD=replace-me
DATABASE_URL=postgres://nmp:replace-me@postgres:5432/nmp?sslmode=disable
DATABASE_MAX_CONNECTIONS=5

ADMIN_GOOGLE_SUB=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SESSION_TTL=720h

MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

EBOOK_MAX_UPLOAD_BYTES=52428800
EBOOK_CLIENT_MAX_BODY_SIZE=51m
TLS_CERTIFICATE_PATH=/absolute/host/path/fullchain.pem
TLS_PRIVATE_KEY_PATH=/absolute/host/path/privkey.pem
