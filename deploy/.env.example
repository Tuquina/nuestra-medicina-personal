APP_DOMAIN=example.com
BACKEND_IMAGE=ghcr.io/example/nuestra-medicina-personal-backend:latest
WEB_IMAGE=ghcr.io/example/nuestra-medicina-personal-web:latest
LOG_MAX_SIZE=10m
LOG_MAX_FILES=5

POSTGRES_DB=nmp
POSTGRES_USER=nmp
POSTGRES_PASSWORD=replace-me
DATABASE_URL=postgres://nmp:replace-me@postgres:5432/nmp?sslmode=disable
DATABASE_MAX_CONNECTIONS=5

# The API is only reachable through the bundled Nginx proxy, which overwrites
# X-Real-IP. Do not enable this when exposing the API port directly.
TRUST_PROXY_HEADERS=true
HTTP_MAX_HEADER_BYTES=32768
HTTP_MAX_REQUEST_URI_BYTES=8192
RATE_LIMIT_WINDOW=1m
RATE_LIMIT_AUTH_REQUESTS=10
RATE_LIMIT_ORDER_REQUESTS=5
RATE_LIMIT_DOWNLOAD_REQUESTS=30
RATE_LIMIT_ADMIN_WRITE_REQUESTS=60

ADMIN_GOOGLE_SUB=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SESSION_TTL=720h

GOOGLE_MAIL_SENDER=ventas@example.com
GOOGLE_MAIL_CREDENTIALS_FILE=/absolute/host/path/gmail-service-account.json
SUPPORT_EMAIL=soporte@example.com
EMAIL_WORKER_INTERVAL=10s
EMAIL_LEASE_TIMEOUT=5m
EMAIL_BATCH_SIZE=5
EMAIL_MAX_ATTEMPTS=5

MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

EBOOK_MAX_UPLOAD_BYTES=52428800
EBOOK_CLIENT_MAX_BODY_SIZE=51m
MEDIA_MAX_UPLOAD_BYTES=10485760
TLS_CERTIFICATE_PATH=/absolute/host/path/fullchain.pem
TLS_PRIVATE_KEY_PATH=/absolute/host/path/privkey.pem
