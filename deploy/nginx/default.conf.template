log_format nmp_json escape=json
    '{"timestamp":"$time_iso8601","level":"info","component":"nginx",'
    '"request_id":"$request_id","remote_address":"$remote_addr",'
    '"method":"$request_method","uri":"$uri","status":$status,'
    '"response_bytes":$body_bytes_sent,"request_duration_seconds":$request_time,'
    '"upstream_duration_seconds":"$upstream_response_time"}';

access_log /dev/stdout nmp_json;
error_log /dev/stderr warn;

# Plain HTTP only — Caddy (deploy/proxy/) is the public edge, terminates TLS
# for every environment on the VPS, and reverse-proxies here over the
# `edge` Docker network. Caddy always forwards X-Real-IP (the real client
# address) and only ever sends traffic it received as HTTPS, so both
# headers below are safe to trust/hardcode.
server {
    listen 80;
    server_name ${SERVER_NAME};
    server_tokens off;

    client_max_body_size ${EBOOK_CLIENT_MAX_BODY_SIZE};
    client_header_timeout 10s;
    client_body_timeout 30s;
    keepalive_timeout 30s;
    large_client_header_buffers 2 16k;

    location /api/ {
        proxy_pass http://api:8080;
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
        proxy_send_timeout 30s;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $http_x_real_ip;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Request-ID $request_id;
    }

    location /health/ {
        proxy_pass http://api:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Request-ID $request_id;
    }

    location /_protected/ebooks/ {
        internal;
        alias /data/ebooks/;
        add_header X-Content-Type-Options nosniff always;
    }

    location /assets/ {
        root /usr/share/nginx/html;
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    location / {
        root /usr/share/nginx/html;
        try_files $uri /index.html;
    }
}
